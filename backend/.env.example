# Database
DATABASE_URL=postgresql+psycopg2://shopuser:shopsecret@localhost:5432/shopdb
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256

# CORS origins (comma-separated). Implicit: localhost + rxpcustom3d.ro
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Payments (optional for Stripe)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Currency & COD (minor units; e.g., 500 = 5.00)
CURRENCY=ron
ENABLE_CASH_ON_DELIVERY=true
CASH_ON_DELIVERY_FEE_MINOR=500

# Email (optional for custom requests)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
ADMIN_EMAILS=admin@yourdomain.com

# Uploads
UPLOAD_DIR=./uploads
